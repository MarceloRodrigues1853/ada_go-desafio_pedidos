FROM golang:1.26-alpine AS builder
WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/payments ./cmd/payments

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/payments /usr/local/bin/payments
EXPOSE 9091
ENTRYPOINT ["payments"]
